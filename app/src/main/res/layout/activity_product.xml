<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/productPageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ürün Öneri Sistemi"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#145A2D"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/diseaseTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hastalık için önerilen ürünler"
            android:textSize="16sp"
            android:textColor="#333333"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/favoriteProductsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_green"
            android:text="Favori Ürünlerim"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
        <Button
            android:id="@+id/productSellerListButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:text="Satıcıları Gör"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_button_green" />

        <EditText
            android:id="@+id/productSearchEditText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:hint="Ürün, kategori veya hastalık ara..."
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_card_white"
            android:textColor="#222222"
            android:textColorHint="#888888" />

        <TextView
            android:id="@+id/productSearchInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arama yaparak ürünleri filtreleyebilirsiniz."
            android:textSize="13sp"
            android:textColor="#666666"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/allButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tümü"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_green" />

                <Button
                    android:id="@+id/fungicideButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fungisit"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_green" />

                <Button
                    android:id="@+id/bactericideButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bakterisit"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_green" />

                <Button
                    android:id="@+id/fertilizerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_green"
                    android:text="Yaprak Gübresi"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/organicButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organik Ürün"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_green" />

            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/productContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp" />

    </LinearLayout>

</ScrollView>