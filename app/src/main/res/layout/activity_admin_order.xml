<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Satıcı Sipariş Talepleri"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#145A2D"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/orderCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toplam Sipariş Talebi: 0"
            android:textSize="15sp"
            android:textColor="#555555"
            android:gravity="center"
            android:paddingBottom="14dp" />

        <Button
            android:id="@+id/clearOrdersButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Tüm Siparişleri Temizle"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_button_green"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:id="@+id/orderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>