<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/treatmentTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tedavi Planı"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#145A2D"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/treatmentRiskText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Risk Seviyesi"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:gravity="center"
            android:background="@drawable/bg_card_white"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/treatmentSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tedavi planı özeti"
            android:textSize="15sp"
            android:textColor="#333333"
            android:background="@drawable/bg_card_white"
            android:padding="16dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uygulanacak Adımlar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#145A2D"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/treatmentStepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/treatmentProductsButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="Önerilen Ürünleri Gör"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_button_green" />

    </LinearLayout>

</ScrollView>