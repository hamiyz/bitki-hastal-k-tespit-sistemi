<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Satıcılar"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#145A2D"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />
        <EditText
            android:id="@+id/sellerSearchEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Satıcı, şehir, ilçe veya uzmanlık ara"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_card_white"
            android:textColor="#222222"
            android:textColorHint="#888888"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/sellerCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toplam Satıcı Sayısı: 0"
            android:textSize="15sp"
            android:textColor="#555555"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/sellerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>