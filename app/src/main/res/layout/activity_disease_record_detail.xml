<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hastalık Kayıt Detayı"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#145A2D"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/detailDiseaseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hastalık"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#145A2D"
                android:gravity="center"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/detailLocationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Konum"
                android:textSize="15sp"
                android:textColor="#333333"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/detailConfidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Güven Oranı"
                android:textSize="15sp"
                android:textColor="#333333"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/detailDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kayıt Tarihi"
                android:textSize="15sp"
                android:textColor="#333333"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/detailRiskText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Risk Seviyesi"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/detailSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Özet"
                android:textSize="15sp"
                android:textColor="#555555"
                android:paddingTop="8dp" />

        </LinearLayout>

        <Button
            android:id="@+id/detailTreatmentButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Tedavi / Bakım Planını Gör"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_button_green"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/detailProductsButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Önerilen Ürünleri Gör"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_button_green" />

    </LinearLayout>

</ScrollView>