<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Satıcı Girişi"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#145A2D"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin paneline yalnızca yetkili satıcılar giriş yapabilir."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/usernameEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Kullanıcı adı"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_card_white"
            android:textColor="#222222"
            android:textColorHint="#888888"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Şifre"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_card_white"
            android:textColor="#222222"
            android:textColorHint="#888888"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/adminLoginButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Giriş Yap"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_button_green" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Demo giriş örnekleri: yesiltarim / 1234, bereket / 1234, akdeniz / 1234"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="18dp" />

    </LinearLayout>

</ScrollView>