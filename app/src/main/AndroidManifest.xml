<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="devilstudio.com.farmerfriend">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">

        <activity android:name=".HistoryActivity" />
        <activity android:name=".AboutActivity" />
        <activity android:name=".ProductActivity" />
        <activity android:name=".OrderRequestActivity" />
        <activity android:name=".AdminActivity" />
        <activity android:name=".AdminOrderActivity" />
        <activity android:name=".DiseaseRecordActivity" />
        <activity android:name=".DiseaseMapActivity" />
        <activity android:name=".FavoriteProductsActivity" />
        <activity android:name=".TreatmentPlanActivity" />
        <activity android:name=".AdminProductActivity" />
        <activity android:name=".DiseaseRecordDetailActivity" />
        <activity android:name=".AdminLoginActivity" />
        <activity android:name=".SellerListActivity" />
        <activity android:name=".MyOrdersActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>